# Firebase project configuration
FIREBASE_PROJECT_ID=loathongbaochuyenkhoan-aaab1

# Configure this path only for local development.
# Do not upload the service account JSON key.
# GOOGLE_APPLICATION_CREDENTIALS=

# Mock Bank webhook authentication
MOCK_BANK_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Session and API token secrets
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-characters

# Frontend configuration
FRONTEND_ORIGINS=https://loathongbaochuyenkhoan-aaab1.web.app,https://loathongbaochuyenkhoan-aaab1.firebaseapp.com

# Public backend URL - set this in the deployment environment
# PUBLIC_BASE_URL=https://your-backend.onrender.com

# Minimum wait before QR orders can be reviewed manually (milliseconds; default 5 minutes)
# MANUAL_PAYMENT_REVIEW_DELAY_MS=300000

# Optional speaker queue mode
# TTS_MODE=queue
